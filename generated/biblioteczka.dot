  "K14" [shape="plain", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff4d6"><TR><TD PORT="autorzy" ROWSPAN="4"><FONT POINT-SIZE="9">autorzy</FONT></TD><TD><B>K14</B></TD><TD PORT="miejsce" ROWSPAN="4"><FONT POINT-SIZE="9">miejsce</FONT></TD></TR><TR><TD>Przedwiośnie</TD></TR><TR><TD>epika / powiesc</TD></TR><TR><TD>oprawa miekka</TD></TR></TABLE>>];


  // ── węzły: ksiazka (K) ──
  "K01" [shape="plain", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e9f7ef"><TR><TD PORT="autorzy" ROWSPAN="4"><FONT POINT-SIZE="9">autorzy</FONT></TD><TD><B>K01</B></TD><TD PORT="miejsce" ROWSPAN="4"><FONT POINT-SIZE="9">miejsce</FONT></TD></TR><TR><TD>Treny</TD></TR><TR><TD>liryka / tren</TD></TR><TR><TD>oprawa twarda</TD></TR></TABLE>>];

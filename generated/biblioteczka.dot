digraph "biblioteczka" {
  graph [rankdir="LR", nodesep=0.25, ranksep=1.1];
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9];

  // ── węzły: autor (A) ──
  "A1" [shape="plain", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#eaf2fb"><TR><TD><B>A1</B></TD><TD PORT="dziela" ROWSPAN="4"><FONT POINT-SIZE="9">dziela</FONT></TD></TR><TR><TD>Jan Kochanowski</TD></TR><TR><TD>renesans</TD></TR><TR><TD>książek: 2</TD></TR></TABLE>>];
  "A2" [shape="plain", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#eaf2fb"><TR><TD><B>A2</B></TD><TD PORT="dziela" ROWSPAN="4"><FONT POINT-SIZE="9">dziela</FONT></TD></TR><TR><TD>Bolesław Prus</TD></TR><TR><TD>pozytywizm</TD></TR><TR><TD>książek: 3</TD></TR></TABLE>>];

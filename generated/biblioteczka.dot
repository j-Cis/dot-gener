  "K01":"miejsce":e -> "P1":"zawartosc":w [id="S01", label="#1", style="dashed", color="#7f8c8d"];
  "K02":"miejsce":e -> "P1":"zawartosc":w [id="S02", label="#2", style="dashed", color="#7f8c8d"];
  "K03":"miejsce":e -> "P2":"zawartosc":w [id="S03", label="#1", style="dashed", color="#7f8c8d"];
